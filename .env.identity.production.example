# Set COMPOSE_PROJECT_NAME to the current provider project name during cutover.
# The database volume must not be mounted by both old and new stacks at once.
COMPOSE_PROJECT_NAME=central-identity-production
AUTH_DOMAIN=identity.example.com
BETTER_AUTH_URL=https://identity.example.com
BETTER_AUTH_SECRET=
# Keep the existing provider database URL and credentials; do not create a new production database volume.
DATABASE_URL=
POSTGRES_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Host Caddy reaches these services through private loopback only.
IDENTITY_AUTH_PORT=3000
IDENTITY_PORT=3001
