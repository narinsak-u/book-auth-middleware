# Set the exact existing provider project name and database volume during cutover.
# Stop the old PostgreSQL container before starting the independent provider.
COMPOSE_PROJECT_NAME=central-identity-production
IDENTITY_DB_VOLUME=verified-existing-central-identity-volume
AUTH_DOMAIN=identity.example.com
BETTER_AUTH_URL=https://identity.example.com
BETTER_AUTH_SECRET=
# Keep the existing provider database URL and credentials; do not create a new production database volume.
DATABASE_URL=
POSTGRES_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Host Caddy reaches these services through private loopback only.
IDENTITY_AUTH_PORT=3000
IDENTITY_PORT=3001
