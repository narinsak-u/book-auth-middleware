{
  "name": "book-auth-middleware",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test src/auth.test.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "provision:bidding": "bun src/provision-bidding.ts",
    "provision:reading": "bun src/provision-reading.ts",
    "db:generate": "drizzle-kit generate --config=src/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "nodemailer": "10.3.1",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "bun-types": "1.4.4",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
