{
  "name": "book-auth-middleware",
  "version": "1.0.50",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:env": "bun test tests/pre-commit.test.ts tests/dev.test.ts",
    "dev:ec": "dotenvx encrypt -f .env.development -fk .env.keys",
    "dev:dc": "dotenvx decrypt -f .env.development -fk .env.keys",
    "all:ec": "bash scripts/env-all.sh encrypt",
    "all:dc": "bash scripts/env-all.sh decrypt",
    "env:pre-commit": "bash scripts/pre-commit-env.sh",
    "dev": "dotenvx run --strict --overload -f .env.development -fk .env.keys -- bun scripts/dev.ts",
    "dev:prod": "DEV_HOST_IP=\"$(sh scripts/dev-host-ip.sh)\" dotenvx run --strict -f .env.test-production -fk .env.test-production.keys -- docker compose --env-file /dev/null --project-name central-test-production -f compose.yaml -f compose.test-production.yaml up --build",
    "start": "bun run --filter @central-identity/server start",
    "web:dev": "bun run --filter @central-identity/web dev",
    "web:start": "bun run --filter @central-identity/web start",
    "db:generate": "bun run --filter @central-identity/db db:generate",
    "db:migrate": "bun run --filter @central-identity/db db:migrate",
    "provision:bidding": "bun run --filter @central-identity/server provision:bidding",
    "provision:reading": "bun run --filter @central-identity/server provision:reading",
    "retarget:oauth-client": "bun run --filter @central-identity/server retarget:oauth-client",
    "disable:central-identity": "bun run --filter @central-identity/server disable:central-identity",
    "recover:identity": "bun run --filter @central-identity/server recover-identity",
    "prepare": "husky"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "bun-types": "1.4.4",
    "husky": "9.1.7",
    "turbo": "2.5.4",
    "typescript": "5.9.3"
  }
}
