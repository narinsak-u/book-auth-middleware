# Fill with separate test-only values, copy to .env.test-production, then run `bun run all:ec` after all environment files and keys are configured.
# Never use development or live-production database, OAuth clients, or Better Auth secret.
COMPOSE_PROJECT_NAME=central-test-production
POSTGRES_DB=central_test_production
POSTGRES_USER=central_test_production
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_DOMAIN=auth-test.localhost:8081
BETTER_AUTH_URL=https://auth-test.localhost:8081
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BIDDING_OIDC_CLIENT_ID=
READING_OIDC_CLIENT_ID=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Central Identity Test <identity-test@localhost>
