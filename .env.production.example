# Supply real values and encrypt with `bunx dotenvx encrypt -f .env.production`.
# Production Compose refuses to start while required values are empty.
AUTH_DOMAIN=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Use the existing Reading checkout path relative to this repository, such as ../read-in-peace.
READING_REPO_PATH=../read-in-peace
# Set the exact existing Docker volume name; never let Compose create a replacement.
READING_DB_VOLUME=
READING_DOMAIN=
READING_POSTGRES_DB=
READING_POSTGRES_USER=
READING_POSTGRES_PASSWORD=
READING_DATABASE_URL=
READING_AUTH_SECRET=
READING_STRIPE_SECRET_KEY=
READING_STRIPE_WEBHOOK_SECRET=
READING_OIDC_CLIENT_ID=
READING_OIDC_CLIENT_SECRET=
READING_OIDC_REDIRECT_URI=
