# Supply real values and encrypt with `bunx dotenvx encrypt -f .env.production`.
# Production Compose refuses to start while required values are empty.
AUTH_DOMAIN=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Keep registration closed unless intentionally launching public enrollment.
ALLOW_SIGN_UP=false
# Set when registering these relying parties in production.
BIDDING_OIDC_CLIENT_ID=
BIDDING_OIDC_REDIRECT_URI=
READING_OIDC_CLIENT_ID=
READING_OIDC_REDIRECT_URI=
