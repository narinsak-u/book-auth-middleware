# Safe local-only defaults. Real .env.development is encrypted with dotenvx.
COMPOSE_PROJECT_NAME=book-auth-middleware
POSTGRES_DB=central
POSTGRES_USER=central
POSTGRES_PASSWORD=central-local-only
DATABASE_URL=postgres://central:central-local-only@db:5432/central
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BIDDING_OIDC_CLIENT_ID=
READING_OIDC_CLIENT_ID=
BETTER_AUTH_SECRET=local-only-change-me-before-any-deployment-32chars
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Central Identity <identity@localhost>
