{$AUTH_DOMAIN} {
  @identity path /api/auth/* /.well-known/* /oauth2/* /health/*
  handle @identity {
    reverse_proxy auth:3000
  }
  handle {
    reverse_proxy web:3001
  }
}

{$READING_DOMAIN} {
  @readingBackend path /api/* /socket.io/*
  handle @readingBackend {
    reverse_proxy reading-backend:4000
  }
  handle {
    reverse_proxy reading-frontend:3000
  }
}
