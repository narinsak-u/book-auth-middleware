{
  auto_https disable_redirects
}

auth.localhost:8080 {
  tls internal
  @identity path /api/auth /api/auth/* /.well-known/* /oauth2/* /health /health/*
  handle @identity {
    reverse_proxy auth:3000
  }
  handle {
    reverse_proxy web:3001
  }
}

