{
  auto_https disable_redirects
}

auth-test.localhost:8081 {
  tls internal
  @identity path /api/auth /api/auth/* /.well-known/* /oauth2/* /health /health/*
  handle @identity {
    reverse_proxy auth:3000
  }
  handle {
    reverse_proxy web:3001
  }
}

bidding-test.localhost:8081 {
  tls internal
  reverse_proxy host.docker.internal:5174
}

reading-test.localhost:8081 {
  tls internal
  reverse_proxy host.docker.internal:3101
}
