{
  auto_https disable_redirects
}

auth-test.127.0.0.1.nip.io:8081 {
  tls internal
  @identity path /api/auth/* /.well-known/* /oauth2/* /health/*
  handle @identity {
    reverse_proxy auth:3000
  }
  handle {
    reverse_proxy web:3001
  }
}

bidding-test.127.0.0.1.sslip.io:8081 {
  tls internal
  reverse_proxy host.docker.internal:5174 {
    transport http {
      max_conns_per_host 4
    }
  }
}

reading-test.lvh.me:8081 {
  tls internal
  reverse_proxy host.docker.internal:3101 {
    transport http {
      max_conns_per_host 4
    }
  }
}
